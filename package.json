{
  "name": "siyuan-mcp",
  "version": "1.0.0",
  "description": "SiYuan Note MCP Server with OAuth authentication via Cloudflare Access",
  "type": "module",
  "overrides": {
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
    "miniflare": {
      "undici": "$undici"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "agents": "^0.7.9",
    "hono": "^4.12.8",
    "lodash-es": "^4.17.23",
    "mime-types": "^3.0.2",
    "node-pdu": "^2.1.2",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.5.0",
    "eventsource": "^4.1.0",
    "typescript": "^5.9.3",
    "undici": "^7.24.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.76.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "siyuan",
    "siyuan-note",
    "mcp",
    "model-context-protocol",
    "cloudflare",
    "workers",
    "oauth"
  ],
  "license": "MIT"
}
